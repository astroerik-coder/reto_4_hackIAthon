        "options": {}
      },
      "id": "2d8f638d-195b-4395-97fc-ff46e45f9e9e",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        600,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "try {\n  let text = $input.first().json.text;\n  text = text.replace(/```json/g, '').replace(/```/g, '');\n  const parsed = JSON.parse(text);\n  \n  // Extraer info del simulador para pasarla a los nodos finales\n  const pacienteInfo = $('Simulador Base de Datos').first().json;\n  parsed.paciente = pacienteInfo.nombre;\n  parsed.sintoma = pacienteInfo.sintoma;\n  parsed.hospital = pacienteInfo.hospital;\n  \n  return parsed;\n} catch (e) {\n  return { error: \"Failed to parse JSON\", original: $input.first().json.text };\n}"
      },
