    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json.body || {};\nconst patientId = inputData.patient_id || \"P-001\";\nconst hospital = inputData.hospital || \"Hospital Central\";\nconst sintoma = inputData.sintoma || \"Dolor de cabeza\";\n\n// Simulador de BD de Aseguradora\nconst db = {\n  \"P-001\": {\n    nombre: \"Juan Pérez\",\n    poliza_activa: true,\n    pre_existencias: [\"Hipertensión\", \"Arritmia\"],\n    plan: \"Premium\"\n  },\n  \"P-002\": {\n    nombre: \"Ana Gómez\",\n    poliza_activa: false,\n    pre_existencias: [],\n    plan: \"Básico\"\n  },\n  \"P-003\": {\n    nombre: \"Carlos Ruiz\",\n    poliza_activa: true,\n    pre_existencias: [\"Asma crónico\"],\n    plan: \"Standard\"\n  }\n};\n\nconst patientData = db[patientId] || { nombre: \"Desconocido\", poliza_activa: false, pre_existencias: [], plan: \"Ninguno\" };\n\nreturn {\n  patientId,\n  hospital,\n  sintoma,\n  ...patientData\n};"
      },
      "id": "84a7e937-29de-4b10-8dc4-b77c5c00e121",
      "name": "Simulador Base de Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        240
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Eres un agente auditor médico.\\nAnaliza el siguiente ingreso a emergencias:\\n\\nPaciente: \" + $json.nombre + \"\\nPóliza Activa: \" + $json.poliza_activa + \"\\nPre-existencias: \" + $json.pre_existencias.join(', ') + \"\\nSíntoma de ingreso: \" + $json.sintoma + \"\\nHospital: \" + $json.hospital + \"\\n\\nDebes determinar:\\n1. validez: ¿La póliza está activa? (true/false)\\n2. alerta_riesgo: ¿El síntoma puede estar relacionado con las pre-existencias? (true/false)\\n3. mensaje_admision: Mensaje corto para el hospital (Aprobar o rechazar ingreso, mencionar si requiere atención especial).\\n4. mensaje_gestor: Mensaje detallado para el gestor de la aseguradora.\\n\\nDevuelve tu respuesta ÚNICAMENTE en formato JSON, usando exactamente las 4 claves mencionadas. No añadas comillas de markdown ni bloques de código.\" }}"
      },
      "id": "038a8eeb-43e8-469b-9c76-5d666d9f379d",
      "name": "Agente Auditor Médico",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        620,
        240
      ]
    },
    {
